{
    "name": "baha2odeh/yii2-oauth",
    "description": "Lightweight OAuth2 authorization server extension for Yii2",
    "type": "yii2-extension",
    "license": "MIT",
    "keywords": ["yii2", "oauth2", "authorization", "authentication"],
    "require": {
        "php": ">=8.1",
        "yiisoft/yii2": "~2.0.45"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "baha2odeh\\yii2oauth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "baha2odeh\\yii2oauth\\tests\\": "tests/"
        }
    },
    "extra": {
        "yii2-extension": {
            "bootstrap": "baha2odeh\\yii2oauth\\OAuthModule"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
